# ─────────────────────────────────────────────
#  The Logic-Gate Vault — .gitignore
#  Team V8 Logic Systems | S25CSEU0980
# ─────────────────────────────────────────────

# Compiled class files — regenerated by javac, never commit these
out/

# Encrypted output files produced at runtime
*.enc

# Temporary write-buffer files (used by FileHandler atomic writes)
*.tmp

# Log file contents — keep the logs/ folder in the repo but not the log data
logs/activity.log

# Data store files written at runtime — keep data/ folder but not runtime files
data/users.dat
data/admin.cfg
data/.vault

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor folders
.vscode/
.idea/
*.iml

# Java packaging artefacts
*.jar
*.war
*.class
